# TEAO Website Environment Variables
# Copy this file to .env.local and fill in the values

# Site
NEXT_PUBLIC_SITE_URL=https://teao-damper.com

# Database (Turso — production only; unset = local SQLite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Auth (JWT signing secret — required in production)
AUTH_SECRET=

# Resend (email notifications)
RESEND_API_KEY=
RESEND_DOMAIN=teao-damper.com
NOTIFY_EMAIL=info@chinateao.com

# API (for future backend integration)
NEXT_PUBLIC_API_URL=
API_KEY=

# Analytics & SEO (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
GOOGLE_SITE_VERIFICATION=

# AI drafts and translation
TRANSLATION_PROVIDER=openai
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Social Media
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_ALIBABA_URL=

# YouTube
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=

# Website operations worker
TEAO_JOBS_SECRET=
# Optional worker URL override. By default, the worker uses PORT.
TEAO_JOBS_URL=
INQUIRY_REPLY_HOURS=24
RESEND_WEBHOOK_SECRET=

# Search Console OAuth (exact callback URL in the Google Cloud web client)
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=https://teao-damper.com/api/admin/search-console/callback
GSC_TOKEN_KEY=

# Cloudflare Turnstile for customer acknowledgments
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
